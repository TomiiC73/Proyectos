# URL de tu instancia de n8n Cloud, SIN barra final.
# Ejemplo: https://tu-subdominio.app.n8n.cloud
N8N_CLOUD_URL=

# n8n Cloud -> Settings -> n8n API -> Create an API key
N8N_API_KEY=

# Si ya existe un workflow en tu cuenta donde querés importar esto (en vez de
# crear uno nuevo), pegá su id acá (se ve en la URL del editor: /workflow/<id>).
# Dejalo vacío para que importar_workflow.js cree uno nuevo.
N8N_WORKFLOW_ID=

# Dos bots de Telegram distintos, creados con @BotFather (/newbot dos veces):
#  - "jugadores": el que usan los participantes para /unirme y responder.
#  - "admin": el tuyo, para /iniciar, /detener y /reiniciar el juego.
TELEGRAM_BOT_TOKEN_JUGADORES=
TELEGRAM_BOT_TOKEN_ADMIN=
