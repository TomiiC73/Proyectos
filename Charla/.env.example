# =============================================================================
# ARCHIVO DE EJEMPLO - ESTE ARCHIVO SI SE COMMITEA
# Copiar como .env y completar los valores reales: cp .env.example .env
# =============================================================================

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.3
GROQ_MAX_TOKENS=4000
PORT=3000

# =============================================================================
# GMAIL IMAP — Para recibir emails reales en el lab (opcional)
# =============================================================================
#
# Permite que el servidor monitoree una bandeja de Gmail y muestre
# los emails recibidos directamente en la bandeja de UTNMail Lab.
#
# PASO 1 — Activá IMAP en tu Gmail:
#   Configuración → Ver todos los ajustes → Reenvío e IMAP → Habilitar IMAP
#
# PASO 2 — Generá una "Contraseña de aplicación" (necesitás 2FA activado):
#   https://myaccount.google.com/apppasswords
#   Elegí "Correo" + dispositivo → Generá → Copiá la clave de 16 caracteres
#
# PASO 3 — Completá en tu .env:
GMAIL_IMAP_USER=tu-cuenta@gmail.com
GMAIL_IMAP_PASS=xxxx xxxx xxxx xxxx
